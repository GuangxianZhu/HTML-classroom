 "groups": {
  "stator": {
   "cn": "定子铁芯",
   "en": "Stator core",
   "desc": "0.2~0.3 mm 硅钢片叠成，槽里放绕组。铁芯把线圈产生的磁通集中到气隙，让同样的电流得到大得多的磁场。"
  },
  "winding": {
   "cn": "发卡绕组（U/V/W 三相）",
   "en": "Hairpin winding",
   "desc": "扁铜线弯成发卡插进定子槽，另一头焊在一起。比圆线绕组槽满率高、端部短，是目前的主流工艺。三相在空间上互差 120° 电角度。"
  },
  "rotor": {
   "cn": "转子（内嵌 V 形永磁体）",
   "en": "IPM rotor",
   "desc": "硅钢叠片里埋着 8 极钕铁硼磁钢，红 N 蓝 S。V 形布置把磁通聚到气隙，也让 q 轴电感大于 d 轴，于是多出一份磁阻转矩。"
  },
  "bearing": {
   "cn": "轴承",
   "en": "Bearings",
   "desc": "两端各一只深沟球轴承。转子每分钟上万转，电机轴承要耐高速，还要防轴电流电蚀。"
  },
  "resolver": {
   "cn": "旋转变压器（测转子角度）",
   "en": "Resolver",
   "desc": "无接触地测转子绝对角度。控制器每 100 μs 左右要知道一次转子转到哪，才知道该把磁场放在哪。"
  },
  "resolver_s": {
   "cn": "旋转变压器定子",
   "en": "Resolver stator",
   "desc": "固定在后端盖上的线圈环，由控制器注入约 10 kHz 的激励，读回 sin / cos 两路信号解算角度。"
  },
  "case": {
   "cn": "电机壳体（带冷却水道）",
   "en": "Motor housing",
   "desc": "铸铝壳体里有水道。电机发热主要在定子铜线和铁芯，靠壳体水冷带走。连续功率常常不是电磁设计决定的，是散热决定的。"
  },
  "cap_rear": {
   "cn": "后端盖",
   "en": "Rear end cover",
   "desc": "封住电机后端，里面装后轴承和旋转变压器定子。"
  },
  "gear1": {
   "cn": "一级主动齿轮",
   "en": "Input pinion",
   "desc": "和转子同轴。电机转一圈它转一圈，是整个减速比的起点。"
  },
  "gear23": {
   "cn": "中间轴双联齿轮",
   "en": "Intermediate gears",
   "desc": "大齿轮接电机小齿轮，小齿轮带差速器。两级相乘得到约 9 倍减速比。"
  },
  "diff": {
   "cn": "主减速大齿轮 + 差速器",
   "en": "Final gear & differential",
   "desc": "扭矩到这里已放大约 9 倍，再由差速器分给左右半轴，转弯时允许两轮转速不同。"
  },
  "reducer_case": {
   "cn": "减速器壳体",
   "en": "Gearbox case",
   "desc": "和电机壳做成一体，这就是三合一电驱的“合”。"
  },
  "reducer_cover": {
   "cn": "减速器后盖",
   "en": "Gearbox cover",
   "desc": "拆开就能看到两级斜齿轮。斜齿比直齿啮合更平顺、噪声更低，这在电动车上很要紧，因为没有发动机声盖住它。"
  },
  "halfshaft": {
   "cn": "半轴",
   "en": "Half shafts",
   "desc": "把减速后的扭矩送到车轮。两端是等速万向节，允许悬架上下跳动。"
  },
  "halfshaft_L": {
   "cn": "半轴",
   "en": "Half shaft",
   "desc": "把减速后的扭矩送到车轮。两端是等速万向节，允许悬架上下跳动。"
  },
  "halfshaft_R": {
   "cn": "半轴",
   "en": "Half shaft",
   "desc": "把减速后的扭矩送到车轮。两端是等速万向节，允许悬架上下跳动。"
  },
  "wheel_L": {
   "cn": "车轮与制动盘",
   "en": "Wheel & brake",
   "desc": "扭矩最后在这里变成推力：F = T / r。制动盘只在回收不够用时才出力。"
  },
  "wheel_R": {
   "cn": "车轮与制动盘",
   "en": "Wheel & brake",
   "desc": "扭矩最后在这里变成推力：F = T / r。制动盘只在回收不够用时才出力。"
  },
  "inv_base": {
   "cn": "逆变器底座（水冷板）",
   "en": "Inverter base",
   "desc": "功率模块贴在水冷板上。逆变器效率 97%~99%，但 150 kW 下那 1%~3% 也是几千瓦的热。"
  },
  "inv_lid": {
   "cn": "逆变器上盖",
   "en": "Inverter cover",
   "desc": "铝盖兼做电磁屏蔽。"
  },
  "igbt": {
   "cn": "功率模块（6 个开关，SiC / IGBT）",
   "en": "Power module",
   "desc": "三相半桥共 6 个开关，每相上下各一个。它们每秒通断上万次，用脉冲宽度拼出正弦电压。同一相的上下管绝不能同时导通。"
  },
  "bus": {
   "cn": "叠层母排与相线",
   "en": "Busbars",
   "desc": "正负母排上下叠在一起抵消寄生电感。开关越快，这里的电感引起的电压尖峰越要命。"
  },
  "cs": {
   "cn": "相电流传感器",
   "en": "Current sensors",
   "desc": "测三相电流，是电流环的反馈。没有它，控制器只知道想要多少扭矩，不知道实际给了多少。"
  },
  "cap": {
   "cn": "直流母线电容",
   "en": "DC-link capacitor",
   "desc": "开关一通一断，电流是一串脉冲。电容就近补足这些脉冲，让电池和高压线上只流平滑的直流。"
  },
  "pcb": {
   "cn": "驱动板 + 控制板",
   "en": "Gate driver & control board",
   "desc": "控制板的 MCU 每 100 μs 左右跑一遍 FOC：读电流和转角 → 算电压 → 改 PWM。驱动板把弱电信号隔离放大去开关功率管。"
  },
  "batt_tray": {
   "cn": "动力电池包",
   "en": "Battery pack",
   "desc": "给逆变器提供 400 V 直流。能放多大功率不只看电机，也看电池：冷、电量低、快满时都会限功率。"
  },
  "batt_mod": {
   "cn": "电芯模组",
   "en": "Battery modules",
   "desc": "几百节电芯串并联成约 400 V。踩下踏板时这里放电，松开踏板回收时这里充电。"
  },
  "batt_lid": {
   "cn": "电池包上盖",
   "en": "Battery lid",
   "desc": "密封防水，隔开高压。"
  },
  "hv": {
   "cn": "高压直流线",
   "en": "HV cable",
   "desc": "橙色是高压线的统一颜色。"
  }
 },
