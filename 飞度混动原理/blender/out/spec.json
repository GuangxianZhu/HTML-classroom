 "groups": {
  "eng_block": {
   "cn": "发动机缸体",
   "en": "Engine block (LEB 1.5 L)",
   "desc": "1.5 L 直列四缸，阿特金森循环（进气门晚关，膨胀比大于压缩比）。在 e:HEV 里它大部分时间只负责发电，只有高速巡航时才通过离合器直接推车。"
  },
  "eng_head": {
   "cn": "缸盖和气门室盖",
   "en": "Cylinder head",
   "desc": "每缸 4 个气门（进 2 排 2），双顶置凸轮轴，链条驱动。进气门晚关就是阿特金森循环的做法：压缩行程开头把一部分空气推回去，换来更大的膨胀比。"
  },
  "intake": {
   "cn": "进气歧管",
   "en": "Intake manifold",
   "desc": "空气经节气门进稳压腔，再分到四个进气道。喷油器装在进气道上（进气道喷射 PFI）。"
  },
  "exhaust": {
   "cn": "排气系统（三元催化 + 消音器）",
   "en": "Exhaust",
   "desc": "燃烧后的废气从缸盖后侧出来，先进三元催化器（要几百度才起作用，所以冷车时发动机会为了暖催化器先运转一会），再经底盘下的管子和消音器排出。"
  },
  "crank": {
   "cn": "曲轴、飞轮减振器",
   "en": "Crankshaft & flywheel damper",
   "desc": "活塞的上下运动在这里变成转动。曲轴另一端直接连着 e-CVT 的输入轴，中间只有一个减振的飞轮盘（没有起动机：发电机兼任起动机）。"
  },
  "piston": {
   "cn": "活塞和连杆",
   "en": "Pistons & connecting rods",
   "desc": "缸径 73.0 mm、行程 89.4 mm 的长行程设计，适合中低转速出扭矩、省油。点火顺序 1-3-4-2。发动机停着的时候它们一动不动，这正是 EV 模式省油的地方。"
  },
  "radiator": {
   "cn": "散热器",
   "en": "Radiator",
   "desc": "发动机和电机、PCU 的冷却液都要在这里散热。电驱部分走另一条低温回路。"
  },
  "batt12": {
   "cn": "12 V 蓄电池",
   "en": "12 V battery",
   "desc": "给灯、仪表、电脑供电的普通小电瓶。它由高压电池经 DC-DC 降压充电，所以混动车不需要传统的发电机皮带。"
  },
  "mot_stator": {
   "cn": "驱动电机定子",
   "en": "Traction motor stator",
   "desc": "真正推车的是它：最大 90 kW、253 N·m（2022 年 10 月小改款后），起步一瞬间就有最大扭矩。它和车轮之间没有离合器，所以它永远跟着车轮转，减速时反过来发电（能量回收）。"
  },
  "mot_rotor": {
   "cn": "驱动电机转子",
   "en": "Traction motor rotor",
   "desc": "永磁转子，最高约 13300 rpm。经 22→54 和 19→65 两级齿轮减速 8.4 倍到车轮。"
  },
  "gen_stator": {
   "cn": "发电机定子",
   "en": "Generator motor stator",
   "desc": "发动机的力先到这里变成电。它和发动机之间也没有离合器，发动机一转它就跟着转（示意齿比 2.0）。它还兼任起动机：要起动发动机时，它反过来当电动机把曲轴转起来。"
  },
  "gen_rotor": {
   "cn": "发电机转子",
   "en": "Generator motor rotor",
   "desc": "永磁转子。发动机停机时它也停着；直驱模式下它跟着空转、基本不出力。"
  },
  "input": {
   "cn": "输入轴（连着发动机）",
   "en": "Input shaft",
   "desc": "和曲轴直连，转速 = 发动机转速。轴上固定着驱动发电机的大齿轮，以及离合器的内毂。"
  },
  "clutch": {
   "cn": "直连离合器（锁止离合器）",
   "en": "Lock-up clutch",
   "desc": "整套 e-CVT 里唯一的离合器，湿式多片。分开时：发动机和车轮之间断开，发动机只发电。接合时：发动机经 67→54、19→65 两级固定齿轮直接推车，总传动比 2.757，没有别的挡位。"
  },
  "edrive": {
   "cn": "发动机直驱齿轮 + 离合器外鼓",
   "en": "Engine-drive gear",
   "desc": "空套在输入轴上，和中间轴大齿轮一直啮合，所以它永远跟着车轮转。离合器分开时它和输入轴各转各的；接合的前一刻，发电机先把发动机转速调到和它一样（同步），再合上，几乎没有冲击。"
  },
  "counter": {
   "cn": "中间轴",
   "en": "Counter shaft",
   "desc": "两条动力在这里汇合：电机小齿轮和发动机直驱齿轮都啮合在同一个 54 齿大齿轮上。轴的另一头是 19 齿主减速齿轮。"
  },
  "diff": {
   "cn": "差速器和主减速齿圈",
   "en": "Differential",
   "desc": "65 齿齿圈。转弯时让左右轮转速不同。到这里为止，电机到车轮总减速 8.40，发动机到车轮 2.757。"
  },
  "case": {
   "cn": "e-CVT 外壳",
   "en": "e-CVT housing",
   "desc": "本田叫它“电气式无段变速机”（e-CVT），但里面没有钢带也没有挡位：两个电机、几对固定齿轮和一个离合器。所谓“无段”，是因为发动机转速可以由发电机自由调节。"
  },
  "pcu": {
   "cn": "PCU（功率控制单元）",
   "en": "Power control unit",
   "desc": "电的总调度：两套逆变器（一套给驱动电机、一套给发电机）加升压器 VCU。电池只有约 173 V，VCU 把它升到最高约 570 V，小电池才能带动 90 kW 的电机。"
  },
  "halfshaft_L": {
   "cn": "前半轴",
   "en": "Front half shaft",
   "desc": "差速器到前轮。两头是等速万向节，悬架上下跳也能传扭矩。右侧那根从发动机油底壳下面穿过去。"
  },
  "halfshaft_R": {
   "cn": "前半轴",
   "en": "Front half shaft",
   "desc": "差速器到前轮。两头是等速万向节，悬架上下跳也能传扭矩。右侧那根从发动机油底壳下面穿过去。"
  },
  "wheel_FL": {
   "cn": "前轮（驱动轮）",
   "en": "Front wheel",
   "desc": "185/60R15 轮胎，半径约 0.30 m。所有动力最后都从这两个前轮落到地面。"
  },
  "wheel_FR": {
   "cn": "前轮（驱动轮）",
   "en": "Front wheel",
   "desc": "185/60R15 轮胎，半径约 0.30 m。所有动力最后都从这两个前轮落到地面。"
  },
  "wheel_RL": {
   "cn": "后轮",
   "en": "Rear wheel",
   "desc": "两驱车型后轮不出力，只跟着滚。"
  },
  "wheel_RR": {
   "cn": "后轮",
   "en": "Rear wheel",
   "desc": "两驱车型后轮不出力，只跟着滚。"
  },
  "rear_axle": {
   "cn": "后扭力梁",
   "en": "Torsion beam",
   "desc": "后悬架。和动力无关，放在这里是为了看清电池和油箱的位置。"
  },
  "tank": {
   "cn": "燃油箱（40 L，中置）",
   "en": "Fuel tank",
   "desc": "飞度的招牌布局：油箱压扁了放在前排座椅下面，后排和后备箱的地板才能做低。燃油从这里送到发动机进气道上的喷油器。"
  },
  "ipu": {
   "cn": "IPU（高压电池包）",
   "en": "Intelligent power unit",
   "desc": "锂离子电池 48 个单体串联，标称约 173 V，放在后备箱地板下。容量本田没公布，混动车一般 1 kWh 左右（我的估计）——只够纯电跑几公里，它的作用是“缓冲”，不是“续航”。"
  },
  "ipu_lid": {
   "cn": "IPU 上盖和 DC-DC",
   "en": "IPU cover",
   "desc": "上盖下面还有电池管理（监控每个单体的电压和温度）、继电器和 DC-DC（给 12 V 系统充电）。"
  },
  "hv": {
   "cn": "高压线（橙色）",
   "en": "High-voltage cables",
   "desc": "直流线从后面的电池沿地板下走到车头的 PCU；三相交流线从 PCU 分别接到驱动电机和发电机。"
  },
  "body": {
   "cn": "车身（示意外形）",
   "en": "Body shell",
   "desc": "一辆普通紧凑两厢车的示意外形：车长约 4.0 m、轴距 2530 mm、轮胎 185/60R15 这些尺寸按飞度取，外观不是飞度的。"
  },
  "cabin": {
   "cn": "车厢（座椅、方向盘）",
   "en": "Cabin",
   "desc": "右舵。前排座椅下面就是中置油箱，后备箱地板下面是电池。"
  }
 },
